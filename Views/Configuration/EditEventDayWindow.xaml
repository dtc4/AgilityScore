<Window x:Class="AgilityScore.Views.Configuration.EditEventDayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar Jornada"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Background="#ECF0F1">

            <!-- 🟦 DATOS GENERALES -->
            <TabItem Header="🗂️ Datos Generales">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Detalles de la Jornada"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"
                                   Foreground="#2C3E50"/>

                        <Label Content="Nombre:"/>
                        <TextBox x:Name="TxtName" Margin="0,0,0,10"/>

                        <Label Content="Fecha:"/>
                        <DatePicker x:Name="DpDate" Margin="0,0,0,10"/>

                        <Label Content="Organiza:"/>
                        <TextBox x:Name="TxtOrganizer" Margin="0,0,0,10"/>

                        <Label Content="Lugar:"/>
                        <TextBox x:Name="TxtLocation" Margin="0,0,0,10"/>

                        <Label Content="Juez:"/>
                        <TextBox x:Name="TxtJudge" Margin="0,0,0,10"/>

                        <Label Content="Orden de inicio:"/>
                        <TextBox x:Name="TxtOrder" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 🟩 RECORRIDOS / COMPETICIONES -->
            <TabItem Header="🏆 Recorridos">
                <Grid Margin="10">
                    <DataGrid x:Name="CompetitionsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#D6EAF8"
                              Background="White"
                              CellEditEnding="CompetitionsGrid_CellEditEnding">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nivel" Binding="{Binding Level}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding Size}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*" IsReadOnly="True"/>

                            <DataGridTextColumn Header="Distancia (m)" Binding="{Binding LengthMeters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                            <DataGridTextColumn Header="Velocidad (m/s)" Binding="{Binding ChosenSpeedMps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                            <DataGridTextColumn Header="Factor TRM" Binding="{Binding TRMFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>

                            <DataGridTextColumn Header="TRS (s)" Binding="{Binding TRS}" Width="1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="TRM (s)" Binding="{Binding TRM}" Width="1*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 🟩 Botones -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Guardar" Width="100" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
