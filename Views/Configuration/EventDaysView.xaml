<UserControl x:Class="AgilityScore.Views.Configuration.EventDaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#ECF0F1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Título -->
        <TextBlock x:Name="TitleText"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Foreground="#2C3E50"/>

        <!-- 🔹 Tabla -->
        <DataGrid x:Name="EventDaysGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#D6EAF8"
                  Background="White"
                  Margin="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>
                <DataGridTextColumn Header="Organiza" Binding="{Binding Organizer}" Width="1.5*"/>
                <DataGridTextColumn Header="Lugar" Binding="{Binding Location}" Width="1.5*"/>
                <DataGridTextColumn Header="Juez" Binding="{Binding Judge}" Width="1.2*"/>
                <DataGridTextColumn Header="Orden de inicio" Binding="{Binding StartOrder}" Width="1.5*"/>

                <!-- Acciones -->
                <DataGridTemplateColumn Header="Acciones" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✏️"
                                        Width="60"
                                        Margin="2"
                                        Click="BtnEditEventDay_Click"/>
                                <Button Content="🗑"
                                        Width="60"
                                        Margin="2"
                                        Background="#E74C3C"
                                        Foreground="White"
                                        Click="BtnDeleteEventDay_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
