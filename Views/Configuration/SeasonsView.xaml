<UserControl x:Class="AgilityScore.Views.Configuration.SeasonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#ECF0F1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Barra superior -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="➕ Nueva Temporada"
                    Width="180"
                    Height="35"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnAddSeason_Click"/>
        </StackPanel>

        <!-- 🔹 Tabla de temporadas -->
        <DataGrid x:Name="SeasonsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#D6EAF8"
                  Background="White"
                  Margin="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Inicio" Binding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" Width="1.5*"/>
                <DataGridTextColumn Header="Fin" Binding="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" Width="1.5*"/>
                <DataGridTextColumn Header="Jornadas" Binding="{Binding EventDaysCount}" Width="1*"/>

                <!-- Acciones -->
                <DataGridTemplateColumn Header="Acciones" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="✏️"
                                        Width="60"
                                        Margin="2"
                                        Click="BtnEditSeason_Click"/>
                                <Button Content="🗑"
                                        Width="60"
                                        Margin="2"
                                        Background="#E74C3C"
                                        Foreground="White"
                                        Click="BtnDeleteSeason_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
