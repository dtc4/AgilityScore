<UserControl x:Class="AgilityScore.Views.Configuration.EventDaysMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#ECF0F1" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔹 Título -->
        <TextBlock Text="📅 Selecciona una temporada"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Foreground="#2C3E50"/>

        <!-- 🔹 Tabla de temporadas -->
        <DataGrid x:Name="SeasonsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#D6EAF8"
                  Background="White"
                  Margin="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Inicio" Binding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>
                <DataGridTextColumn Header="Fin" Binding="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" Width="1.2*"/>
                <DataGridTextColumn Header="Jornadas" Binding="{Binding EventDaysCount}" Width="1*"/>

                <!-- Acciones -->
                <DataGridTemplateColumn Header="Ver Jornadas" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="📆 Ver"
                                    Width="100"
                                    Height="30"
                                    Margin="5"
                                    Background="#3498DB"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="BtnViewEventDays_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
